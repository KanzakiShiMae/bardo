<?xml version="1.0" encoding="UTF-8"?>

<?import javafx.scene.control.*?>
<?import javafx.scene.image.*?>
<?import javafx.scene.layout.*?>
<?import javafx.scene.canvas.*?>
<?import javafx.scene.shape.*?>
<?import javafx.scene.text.*?>
<?import javafx.geometry.*?>

<BorderPane xmlns="http://javafx.com/javafx/21"
            xmlns:fx="http://javafx.com/fxml/1"
            fx:controller="com.musicplayer.controllers.MainController"
            styleClass="root-pane">

    <!-- ═══════════════════ TOP BAR ═══════════════════ -->
    <top>
        <HBox fx:id="titleBar" styleClass="title-bar" alignment="CENTER_LEFT">

            <HBox spacing="8" alignment="CENTER_LEFT" style="-fx-padding: 0 0 0 16;">
                <TextField fx:id="searchField"
                           promptText="Buscar en YouTube…"
                           styleClass="top-search-field"
                           prefWidth="240"
                           onAction="#onSearchAction" />
                <Button fx:id="btnSearchGo" text="⌕" styleClass="search-go-btn"
                        onAction="#onSearchAction" />
            </HBox>

            <HBox alignment="CENTER" HBox.hgrow="ALWAYS">
                <Label fx:id="appTitleLabel" text="Bardo" styleClass="app-title" />
            </HBox>

            <HBox spacing="0" alignment="CENTER_RIGHT">
                <Button fx:id="btnMinimize" styleClass="win-btn, win-minimize" text="−" maxHeight="Infinity" />
                <Button fx:id="btnMaximize" styleClass="win-btn, win-maximize" text="⛶" maxHeight="Infinity" />
                <Button fx:id="btnClose"    styleClass="win-btn, win-close"    text="✕" maxHeight="Infinity" />
            </HBox>

        </HBox>
    </top>

    <!-- ═══════════════════ CENTER ═══════════════════ -->
    <center>
        <HBox>

            <!-- ──── SIDEBAR ──── -->
            <VBox fx:id="sidebar" styleClass="sidebar" spacing="4" prefWidth="220">

                <VBox alignment="CENTER" styleClass="sidebar-header">
                    <StackPane fx:id="sidebarLogoStack" style="-fx-cursor: hand;" prefWidth="180" prefHeight="180" minWidth="180" minHeight="180">
                        <ImageView fx:id="sidebarLogo"       fitWidth="180" fitHeight="180" preserveRatio="true" smooth="true" />
                        <ImageView fx:id="sidebarLogoNext"   fitWidth="180" fitHeight="180" preserveRatio="true" smooth="true" opacity="0" mouseTransparent="true" />
                        <ImageView fx:id="sidebarLogoFilter" fitWidth="180" fitHeight="180" preserveRatio="true" smooth="true" mouseTransparent="true" />
                        <ImageView fx:id="sidebarLogoBorder" fitWidth="180" fitHeight="180" preserveRatio="true" smooth="true" mouseTransparent="true" />
                    </StackPane>
                </VBox>

                <Separator styleClass="sidebar-divider" />

                <Label text="NAVEGAR" styleClass="sidebar-section-label" />
                <Button fx:id="btnHome"     text="  🏠  Inicio"        styleClass="nav-btn, nav-btn-active" maxWidth="Infinity" />
                <Button fx:id="btnLibrary"  text="  📚  Biblioteca"   styleClass="nav-btn"                maxWidth="Infinity" />
                <Button fx:id="btnSettings" text="  ⚙  Configuración" styleClass="nav-btn"                maxWidth="Infinity" />

                <Separator styleClass="sidebar-divider" />

                <Label text="MIS COLECCIONES" styleClass="sidebar-section-label" />
                <Button fx:id="btnNewGroup" text="＋  Nueva colección"
                        styleClass="nav-btn, new-playlist-btn" maxWidth="Infinity"
                        onAction="#onNewGroupAction" />

                <ListView fx:id="groupListView" styleClass="playlist-list" VBox.vgrow="ALWAYS" />

            </VBox>

            <!-- ──── TABS + CONTENT ──── -->
            <VBox HBox.hgrow="ALWAYS">
                <ScrollPane fx:id="tabBarScroll" styleClass="tab-bar-scroll"
                            fitToHeight="true" hbarPolicy="NEVER" vbarPolicy="NEVER"
                            prefHeight="42" minHeight="42" maxHeight="42">
                    <HBox fx:id="tabBar" styleClass="tab-bar" />
                </ScrollPane>
                <StackPane fx:id="contentArea" VBox.vgrow="ALWAYS" styleClass="content-area">

                <!-- HOME PANEL — content built dynamically in MainController.refreshHomePanel() -->
                <VBox fx:id="homePanel" styleClass="panel" spacing="24" visible="true" />

                <!-- SEARCH PANEL -->
                <VBox fx:id="searchPanel" styleClass="panel" spacing="16" visible="false" managed="false">
                    <padding><Insets top="24" right="28" bottom="28" left="28" /></padding>

                    <!-- Mode toggle -->
                    <HBox spacing="8" alignment="CENTER_LEFT" styleClass="search-toggle-bar">
                        <Button fx:id="btnSearchVideos"    text="🎵  Videos"    styleClass="toggle-btn, toggle-btn-active" onAction="#onToggleSearchMode" />
                        <Button fx:id="btnSearchPlaylists" text="📋  Playlists" styleClass="toggle-btn"                    onAction="#onToggleSearchMode" />
                        <HBox HBox.hgrow="ALWAYS" />
                        <Label fx:id="searchStatusLabel" styleClass="search-status" text="" />
                        <ProgressIndicator fx:id="searchSpinner" styleClass="search-spinner"
                                           prefWidth="18" prefHeight="18" visible="false" />
                    </HBox>

                    <ScrollPane styleClass="results-scroll" fitToWidth="true" VBox.vgrow="ALWAYS">
                        <FlowPane fx:id="searchResultsPane" styleClass="results-pane" hgap="16" vgap="16" prefWrapLength="600" />
                    </ScrollPane>
                </VBox>

                <!-- LIBRARY PANEL -->
                <VBox fx:id="libraryPanel" styleClass="panel" spacing="16" visible="false" managed="false">
                    <padding><Insets top="28" right="28" bottom="28" left="28" /></padding>

                    <HBox alignment="CENTER_LEFT" spacing="12">
                        <VBox spacing="3" HBox.hgrow="ALWAYS">
                            <Label text="Biblioteca" styleClass="greeting" />
                            <Label text="Tus canciones y colecciones" styleClass="greeting-sub" />
                        </VBox>
                        <Button text="＋  Nueva colección" styleClass="btn-primary"
                                onAction="#onNewGroupAction" />
                    </HBox>

                    <ScrollPane styleClass="results-scroll" fitToWidth="true" VBox.vgrow="ALWAYS">
                        <VBox fx:id="libraryGroupsContainer" styleClass="library-groups" spacing="10" />
                    </ScrollPane>
                </VBox>

                <!-- SETTINGS PANEL -->
                <VBox fx:id="settingsPanel" styleClass="panel" spacing="24" visible="false" managed="false">
                    <padding><Insets top="28" right="28" bottom="28" left="28" /></padding>
                </VBox>

                </StackPane>
            </VBox>

        </HBox>
    </center>

    <!-- ═══════════════════ BOTTOM — NOW PLAYING ═══════════════════ -->
    <bottom>
        <HBox fx:id="nowPlayingBar" styleClass="now-playing-bar" alignment="CENTER" spacing="0">

            <!-- Song info -->
            <HBox spacing="12" alignment="CENTER_LEFT" prefWidth="270" minWidth="220"
                  style="-fx-padding: 0 0 0 12;">
                <StackPane fx:id="vinylContainer" styleClass="vinyl-container">
                    <ImageView fx:id="albumArt" fitWidth="78" fitHeight="44" styleClass="album-art" />
                    <Canvas fx:id="miniWaveCanvas" width="78" height="44" />
                </StackPane>
                <VBox spacing="2" alignment="CENTER_LEFT" HBox.hgrow="ALWAYS">
                    <Label fx:id="nowPlayingTitle"  text="Selecciona una canción"
                           styleClass="np-title"  maxWidth="150" />
                    <Label fx:id="nowPlayingArtist" text="–"
                           styleClass="np-artist" />
                </VBox>
                <Button text="🔗" styleClass="np-like-btn" onAction="#onOpenInBrowser" />
            </HBox>

            <!-- Controls + progress -->
            <VBox spacing="5" alignment="CENTER" HBox.hgrow="ALWAYS">
                <HBox spacing="20" alignment="CENTER">
                    <Button fx:id="btnPrev"      text="⏮" styleClass="control-btn" />
                    <Button fx:id="btnPlayPause" text="▶" styleClass="play-btn"    />
                    <Button fx:id="btnNext"      text="⏭" styleClass="control-btn" />
                </HBox>
                <HBox spacing="8" alignment="CENTER">
                    <Label fx:id="timeElapsed" text="0:00" styleClass="time-label" />
                    <Slider fx:id="progressSlider" styleClass="progress-slider"
                            prefWidth="360" min="0" max="100" value="0" />
                    <Label fx:id="timeTotal" text="0:00" styleClass="time-label" />
                </HBox>
            </VBox>

            <!-- Secondary controls + volume -->
            <HBox spacing="6" alignment="CENTER_RIGHT" prefWidth="240" minWidth="200"
                  style="-fx-padding: 0 20 0 0;">
                <Button fx:id="btnShuffle" text="⇄" styleClass="control-btn" />
                <Button fx:id="btnRepeat"  text="↺" styleClass="control-btn" />
                <Button text="⇆" styleClass="control-btn" onAction="#onSwitchFocusedPlayer" />
                <Slider fx:id="volumeSlider" styleClass="volume-slider"
                        prefWidth="80" min="0" max="100" value="70" />
                <Label fx:id="volumeLabel" text="70%" styleClass="volume-pct-label" />
            </HBox>

        </HBox>
    </bottom>

</BorderPane>